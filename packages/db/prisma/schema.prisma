generator client {
  provider       = "prisma-client-js"
  driverAdapters = ["pg"]
}

datasource db {
  provider = "postgresql"
}

enum Severity {
  Low
  Medium
  High
}

enum UserRole {
  Official
  Admin
  SuperAdmin
}

model User {
  id         String   @id @default(cuid())
  username   String   @unique
  fullName   String?
  email      String?
  nationalId String?  @unique
  password   String
  role       UserRole @default(Official)
  isBlocked  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  complaints        Complaint[]
  letterGenerations LetterGeneration[]

  notifications         Notification[]
  actorNotifications    Notification[]         @relation("ActorNotifications")
  passwordResetRequests PasswordResetRequest[]
}

model Notification {
  id            String    @id @default(cuid())
  recipientId   String?
  recipientRole UserRole?
  actorId       String?
  type          String
  title         String
  body          String
  resourceId    String?
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  recipient User? @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User? @relation("ActorNotifications", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([recipientId])
  @@index([recipientRole])
  @@index([createdAt])
}

model PasswordResetRequest {
  id          String              @id @default(cuid())
  userId      String
  requestedBy String
  status      PasswordResetStatus @default(Pending)
  requestedAt DateTime            @default(now())
  resolvedAt  DateTime?
  resolvedBy  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

enum PasswordResetStatus {
  Pending
  Approved
  Rejected
}

model Citizen {
  id           String    @id @default(cuid())
  fullName     String
  nationalId   String?   @unique
  mobileNumber String?
  address      String?
  village      String?
  district     String?
  locationCode String?
  location     Location? @relation(fields: [locationCode], references: [code])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  complaints Complaint[]
}

model Location {
  code       String     @id
  name       String
  parentCode String?
  parent     Location?  @relation("LocationHierarchy", fields: [parentCode], references: [code])
  children   Location[] @relation("LocationHierarchy")
  level      Int?
  levelDesc  String?
  p0         String?
  p1         String?
  p2         String?
  p3         String?
  p4         String?
  p5         String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  citizens Citizen[]

  @@index([parentCode])
}

model Department {
  id           String   @id @default(cuid())
  name         String
  subAuthority String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  complaints           Complaint[]
  complaintDepartments ComplaintDepartment[]
  urgencies            ComplaintUrgency[]
}

model ReceptionMethod {
  id   Int    @id @default(autoincrement())
  name String @unique

  complaints Complaint[]
}

model ComplaintType {
  id   Int    @id @default(autoincrement())
  name String @unique

  complaints Complaint[]
}

model ExaminationStatus {
  id   Int    @id @default(autoincrement())
  name String @unique

  complaints           Complaint[]
  complaintDepartments ComplaintDepartment[]
}

model PresentationStatus {
  id   Int    @id @default(autoincrement())
  name String @unique

  complaints Complaint[]
}

model Complaint {
  id                     String              @id @default(cuid())
  complaintNumber        Int
  statementYear          Int
  arrivalDate            DateTime
  severity               Severity            @default(Low)
  receptionMethodId      Int?
  receptionMethod        ReceptionMethod?    @relation(fields: [receptionMethodId], references: [id])
  complaintTypeId        Int?
  complaintType          ComplaintType?      @relation(fields: [complaintTypeId], references: [id])
  subject                String
  respondentName         String?
  departmentId           String?
  department             Department?         @relation(fields: [departmentId], references: [id])
  presentationStatusId   Int?
  presentationStatus     PresentationStatus? @relation(fields: [presentationStatusId], references: [id])
  annotation             String?
  examinationStatusId    Int?
  examinationStatus      ExaminationStatus?  @relation(fields: [examinationStatusId], references: [id])
  examinationResult      String?
  authorityResponseText  String?
  authorityResponseDate  DateTime?
  outgoingLetterNumber   String?
  outgoingLetterDate     DateTime?
  incomingResponseNumber String?
  notificationMethod     String?
  notificationOutNumber  String?
  notificationOutDate    DateTime?
  archiveNumber          String?
  archiveDate            DateTime?
  archiveLocation        String?
  weeklyMeeting          Int?
  finalDecisionDate      DateTime?
  endDate                DateTime?
  attachmentCount        Int?                @default(0)
  createdByUserId        String?
  createdBy              User?               @relation(fields: [createdByUserId], references: [id])
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  citizenId String
  citizen   Citizen @relation(fields: [citizenId], references: [id])

  actions           ComplaintAction[]
  escalations       ComplaintEscalation[]
  files             ComplaintFile[]
  linksFrom         ComplaintLink[]       @relation("LinkedFrom")
  linksTo           ComplaintLink[]       @relation("LinkedTo")
  socialDrafts      SocialDraft[]
  departments       ComplaintDepartment[]
  urgencies         ComplaintUrgency[]
  letterGenerations LetterGeneration[]

  @@unique([complaintNumber, statementYear])
  @@index([citizenId])
  @@index([departmentId])
  @@index([statementYear])
  @@index([createdAt])
}

model ComplaintDepartment {
  id              String     @id @default(cuid())
  complaintId     String
  complaint       Complaint  @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  departmentId    String
  department      Department @relation(fields: [departmentId], references: [id])
  createdAt       DateTime   @default(now())
  endedAt         DateTime?
  assignmentIndex Int        @default(1)

  outgoingLetterNumber String?
  outgoingLetterDate   DateTime?
  responseDeadlineDays Int?

  responseText        String?
  responseNumber      String?
  responseDate        DateTime?
  importDate          DateTime?
  examinationStatusId Int?
  examinationStatus   ExaminationStatus? @relation(fields: [examinationStatusId], references: [id])
  examinationResult   String?
  respondedAt         DateTime?
  updatedAt           DateTime           @updatedAt

  urgencies ComplaintUrgency[]

  @@index([complaintId, departmentId])
  @@index([departmentId])
}

model ComplaintUrgency {
  id                   String               @id @default(cuid())
  complaintId          String
  complaint            Complaint            @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  departmentId         String
  department           Department           @relation(fields: [departmentId], references: [id])
  assignmentId         String?
  assignment           ComplaintDepartment? @relation(fields: [assignmentId], references: [id])
  outgoingLetterNumber String
  outgoingLetterDate   DateTime
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([complaintId])
  @@index([departmentId])
  @@index([assignmentId])
}

model ComplaintAction {
  id          String    @id @default(cuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  action      String
  actionDate  DateTime
  notes       String?
  createdAt   DateTime  @default(now())

  @@index([complaintId])
}

model ComplaintEscalation {
  id            String    @id @default(cuid())
  complaintId   String
  complaint     Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  urgencyNumber String?
  urgencyDate   DateTime?
  responseDate  DateTime?
  createdAt     DateTime  @default(now())

  @@index([complaintId])
}

model ComplaintFile {
  id          String    @id @default(cuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  fileType    String
  storageKey  String
  uploadedAt  DateTime  @default(now())

  @@index([complaintId])
}

model ComplaintLink {
  id        String    @id @default(cuid())
  sourceId  String
  source    Complaint @relation("LinkedFrom", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId  String
  target    Complaint @relation("LinkedTo", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([sourceId, targetId])
  @@index([sourceId])
  @@index([targetId])
}

model ComplaintYearCounter {
  year          Int @id
  currentNumber Int @default(0)
}

model GeneratedReport {
  id          String   @id @default(cuid())
  type        String
  periodLabel String
  periodStart DateTime
  periodEnd   DateTime
  data        Json
  format      String?
  storageKey  String?
  generatedAt DateTime @default(now())

  @@index([generatedAt])
  @@index([type])
}

model DelayThreshold {
  id         Int      @id @default(1)
  lowDays    Int      @default(45)
  mediumDays Int      @default(30)
  highDays   Int      @default(15)
  updatedAt  DateTime @updatedAt
}

enum SocialDraftStatus {
  Pending
  Approved
  Rejected
}

enum GroupType {
  Group
  Page
}

model MonitoredGroup {
  id        String    @id @default(cuid())
  groupId   String    @unique
  name      String
  type      GroupType @default(Group)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isActive])
}

model SocialDraft {
  id              String            @id @default(cuid())
  sourcePostId    String            @unique
  sourceLink      String
  postText        String
  authorName      String?
  postedAt        DateTime
  detectedAt      DateTime          @default(now())
  status          SocialDraftStatus @default(Pending)
  groupId         String?
  groupName       String?
  notes           String?
  extractedFields Json?
  complaintId     String?
  complaint       Complaint?        @relation(fields: [complaintId], references: [id], onDelete: SetNull)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status])
  @@index([detectedAt])
}

enum LetterTemplateType {
  HTML
  DOCX
  PDF_LETTERHEAD
}

model LetterTemplate {
  id          String             @id @default(cuid())
  name        String
  description String?
  type        LetterTemplateType @default(HTML)
  body        String?
  assetKey    String?
  variables   Json?
  isActive    Boolean            @default(true)
  isDefault   Boolean            @default(false)
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  generations LetterGeneration[]

  @@index([isActive])
}

model LetterSettings {
  id                     Int      @id @default(1)
  organizationNameAr     String?
  organizationNameEn     String?
  organizationAddress    String?
  organizationPhone      String?
  organizationFax        String?
  organizationEmail      String?
  organizationWebsite    String?
  organizationLetterhead String?
  managerName            String?
  managerTitle           String?
  managerSignature       String?
  seal                   String?
  responseDefaultDays    Int      @default(15)
  updatedAt              DateTime @updatedAt
}

model LetterGeneration {
  id             String   @id @default(cuid())
  complaintId    String
  templateId     String
  fileKey        String
  variableValues Json?
  generatedById  String
  createdAt      DateTime @default(now())

  complaint   Complaint      @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  template    LetterTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  generatedBy User           @relation(fields: [generatedById], references: [id])

  @@unique([complaintId, templateId])
  @@index([templateId])
}
