{
  "name": "complaints-system",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/api",
    "build": "npm run build -w apps/api",
    "typecheck": "npm run typecheck -w apps/api",
    "prisma:generate": "npm run prisma:generate -w packages/db",
    "prisma:migrate": "npm run prisma:migrate -w packages/db",
    "prisma:studio": "npm run prisma:studio -w packages/db",
    "prisma:seed": "npm run prisma:seed -w packages/db",
    "bruno:test": "bru run apps/api/bruno --env Local",
    "bruno:ci": "bru run apps/api/bruno --env CI"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "esbuild": true,
    "prisma": true,
    "@prisma/engines": true
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0"
  }
}
