# Copy to deploy/.env.production and fill in. This file is read by the api
# container (env_file in docker-compose.prod.yml) and is excluded from the
# Docker build context (.dockerignore) — never commit it.
#
# DATABASE_URL comes from the compose file (or root .env) — no need to set it here.

# --- Auth ---------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string

# --- Server -------------------------------------------------------------
PORT=3000

# --- AI / Mastra --------------------------------------------------------
# Chat LLM. "sbg/" uses the ITI SBG gateway (needs SBG_BASE_URL + SBG_API_KEY);
# "openai/...", "google/...", "anthropic/..." use the matching provider key.
LLM_MODEL=sbg/amazon.nova-lite-v1:0
# LLM_MODEL=sbg/us.anthropic.claude-sonnet-4-6   # higher quality
# LLM_MODEL=openai/gpt-4o-mini

EMBEDDING_MODEL=openai/text-embedding-3-small
# NOTE: changing EMBEDDING_MODEL to a different dimension drops the
# complaint_embeddings table at startup — run the reindex endpoint afterwards.

SBG_BASE_URL=http://apiaccess.iti.net.eg/api/v1
SBG_API_KEY=sbg_...

# OpenAI (only needed if using "openai/" models)
OPENAI_API_KEY=sk-...

# --- Social Media Monitoring -------------------------------------------
SOCIAL_SOURCE=graph            # "graph" (default) or "apify"
FB_ACCESS_TOKEN=""             # long-lived token from a genuine governorate account
APIFY_API_KEY=""
APIFY_FACEBOOK_ACTOR=apify/facebook-groups-scraper