# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/complaints"

# Auth
JWT_SECRET="secret"

# Server
PORT=3000

# File uploads
UPLOAD_DIR="uploads"

# AI / Mastra
LLM_MODEL="google/gemini-3.6-flash"

# Embedding model for vector search (used when LLM_MODEL is set)
EMBEDDING_MODEL="google/gemini-embedding-2"

# API key for the AI provider — Mastra reads these implicitly based on model prefix
# e.g. OPENAI_API_KEY for "openai/..." or "gpt-...", ANTHROPIC_API_KEY for "claude-..."
# OPENAI_API_KEY="sk-..."
GOOGLE_API_KEY="AQ.as------------------------"

# Social Media Monitoring — Data Source
# "graph" (default) — calls Facebook Graph API directly (needs FB_ACCESS_TOKEN)
# "apify" — uses Apify actors (needs APIFY_API_KEY)
SOCIAL_SOURCE=graph

# Facebook Graph API access token (used when SOCIAL_SOURCE=graph)
# A long-lived user access token from a governorate account that is a genuine
# member/admin of each target group/page being monitored.
FB_ACCESS_TOKEN=""

# Apify API key (used when SOCIAL_SOURCE=apify)
# Find at https://console.apify.com/settings/integrations
APIFY_API_KEY=""
# Which Apify actor to use for Facebook scraping
# Default: danek/facebook-pages-posts-ppr
APIFY_FACEBOOK_ACTOR="danek/facebook-pages-posts-ppr"
