# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/complaints"

# Auth
JWT_SECRET="change-me-in-production"

# Server
PORT=3000

# File uploads
UPLOAD_DIR="uploads"

# AI / Mastra
# Set LLM_MODEL to enable AI features (severity scoring, recurrence detection)
# When empty (""), AI features are disabled and:
#   - Severity always returns "MEDIUM" (no AI scoring)
#   - Recurrence detection falls back to structured match only (National ID)
#   - Embedding-based similarity and agent reasoning are skipped
# Examples: "gpt-4o", "google/gemini-3.6-flash"
LLM_MODEL=""

# Embedding model for vector search
# Note: embeddings are generated regardless of LLM_MODEL (needed for vector index)
# Default: "google/gemini-embedding-2"
EMBEDDING_MODEL="google/gemini-embedding-2"

# API key for the AI provider — Mastra reads these implicitly based on model prefix
# e.g. OPENAI_API_KEY for "openai/..." or "gpt-...", GOOGLE_API_KEY for "google/..."
# GOOGLE_API_KEY="AIza..."
