# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/complaints"

# Auth
JWT_SECRET="secret"

# Server
PORT=3000

# File uploads
UPLOAD_DIR="uploads"

# AI / Mastra
# Chat LLM. Providers Mastra bundles (google/openai/anthropic/...) resolve via
# its model router and read their API key from the matching env var:
#   google/...        -> GOOGLE_API_KEY
#   openai/...        -> OPENAI_API_KEY
#   anthropic/...     -> ANTHROPIC_API_KEY
#   deepseek/...      -> DEEPSEEK_API_KEY
# The ITI SBG gateway (Bedrock-backed LLM access) is NOT bundled — use the
# "sbg/<model-id>" prefix (handled by apps/api/src/common/llm/model-provider.ts)
# with the Bearer token SBG_API_KEY:
#   sbg/amazon.nova-lite-v1:0           (bulk)
#   sbg/us.anthropic.claude-sonnet-4-6  (quality)
LLM_MODEL="sbg/amazon.nova-lite-v1:0"

# Embedding model for vector search (resolved through Mastra's model router)
# NOTE: changing EMBEDDING_MODEL to a different dimension (e.g. 1536 -> 1024)
# automatically drops the complaint_embeddings table on next startup — run the
# reindex endpoint afterwards to repopulate it.
EMBEDDING_MODEL="openai/text-embedding-3-small"

# ITI SBG gateway (used when LLM_MODEL uses "sbg/")
SBG_BASE_URL="http://apiaccess.iti.net.eg/api/v1"
SBG_API_KEY="sbg_..."

# OpenAI (used when models use "openai/")
OPENAI_API_KEY="sk-..."

# Social Media Monitoring — Data Source
# "graph" (default) — calls Facebook Graph API directly (needs FB_ACCESS_TOKEN)
# "apify" — uses Apify actors (needs APIFY_API_KEY)
SOCIAL_SOURCE=graph

# Facebook Graph API access token (used when SOCIAL_SOURCE=graph)
# A long-lived user access token from a governorate account that is a genuine
# member/admin of each target group/page being monitored.
FB_ACCESS_TOKEN=""

# Apify API key (used when SOCIAL_SOURCE=apify)
# Find at https://console.apify.com/settings/integrations
APIFY_API_KEY=""
# Which Apify actor to use for Facebook scraping
# Default: apify/facebook-groups-scraper
APIFY_FACEBOOK_ACTOR="apify/facebook-groups-scraper"
