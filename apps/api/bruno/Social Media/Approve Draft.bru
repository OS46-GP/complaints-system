meta {
  name: Approve Draft
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/social/drafts/{{draftId}}/approve
  body: none
}

headers {
  Authorization: Bearer {{token}}
}

assert {
  res.status: eq(201)
  res.body.id: $notNull
  res.body.complaintNumber: $notNull
}

script:post-response {
  const data = res.getBody();
  if (data.id) {
    bru.setVar("complaintId", data.id);
  }
}