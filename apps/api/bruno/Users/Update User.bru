meta {
  name: Update User
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/users/{{userId}}
  body: json
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "password": "newPassword456",
    "role": "Admin"
  }
}

assert {
  res.status: eq(200)
  res.body.id: eq({{userId}})
  res.body.role: eq(Admin)
}
