meta {
  name: Summarize Complaint
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/ai/summarize/{{complaintId}}
  body: none
}

headers {
  Authorization: Bearer {{token}}
}

assert {
  res.status: eq(201)
  res.body.draft: $notNull
}

script:post-response {
  const data = res.getBody();
  if (data.draft) {
    console.log("AI Summary Draft generated successfully");
  }
}
