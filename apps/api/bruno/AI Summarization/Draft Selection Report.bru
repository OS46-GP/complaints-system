meta {
  name: Draft Selection Report
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/ai/draft-selection-report
  body: json
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "complaintIds": ["__COMPLAINT_ID_1__", "__COMPLAINT_ID_2__"]
  }
}

assert {
  res.status: eq(201)
  res.body.draft: $notNull
}