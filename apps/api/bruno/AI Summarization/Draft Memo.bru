meta {
  name: Draft Memo
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/ai/draft-memo/{{complaintId}}
  body: none
}

headers {
  Authorization: Bearer {{token}}
}

assert {
  res.status: eq(201)
  res.body.draft: $notNull
}

script:post-response {
  const data = res.getBody();
  if (data.draft) {
    console.log("AI Memo Draft generated successfully");
  }
}
