meta {
  name: Upload DOCX Template Asset
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/letter-templates/{{docxTemplateId}}/asset
  body: multipart-form
}

headers {
  Authorization: Bearer {{token}}
}

body:multipart-form {
  file: @file("_files/test-letter.docx")
}

assert {
  res.status: eq(201)
  res.body.assetKey: $notNull
}