meta {
  name: Preview Draft Letter (HTML)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/letter-templates/preview-draft
  body: multipart-form
}

headers {
  Authorization: Bearer {{token}}
}

body:multipart-form {
  type: HTML
  body: <div class="letter-head"><div class="org-name">{{organizationNameAr}}</div></div><p class="to">إلى السيد/ مدير {{department}}</p><p>{{subject}}</p><div class="sign">{{managerName}}</div>
}

assert {
  res.status: eq(201)
  res.headers.content-type: contains("pdf")
}