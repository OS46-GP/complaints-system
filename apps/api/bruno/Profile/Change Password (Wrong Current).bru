meta {
  name: Change Password (Wrong Current)
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/profile/password
  body: json
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "currentPassword": "wrong-password",
    "newPassword": "newpassword123"
  }
}

assert {
  res.status: eq(401)
}
