meta {
  name: Change Password
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/profile/password
  body: json
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "currentPassword": "{{password}}",
    "newPassword": "{{newPassword}}"
  }
}

assert {
  res.status: eq(200)
  res.body.success: eq(true)
}
