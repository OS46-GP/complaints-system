meta {
  name: Restore Password
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/profile/password
  body: json
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "currentPassword": "{{newPassword}}",
    "newPassword": "{{password}}"
  }
}

assert {
  res.status: eq(200)
  res.body.success: eq(true)
}
