meta {
  name: List Complaints
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/complaints
}

headers {
  Authorization: Bearer {{token}}
}

query {
  page: 1
  limit: 20
}

assert {
  res.status: eq(200)
  res.body.data: $notNull
  res.body.total: $notNull
  res.body.page: $notNull
  res.body.limit: $notNull
}
