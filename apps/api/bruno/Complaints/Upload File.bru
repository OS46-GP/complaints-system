meta {
  name: Upload File
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/complaints/{{complaintId}}/files
  body: multipart-form
}

headers {
  Authorization: Bearer {{token}}
}

body:multipart-form {
  file: @file("test-document.pdf")
  fileType: authority-response
}

assert {
  res.status: eq(201)
  res.body.id: $notNull
  res.body.fileType: $notNull
  res.body.storageKey: $notNull
}
