meta {
  name: Generate Memo
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/complaints/{{complaintId}}/memo
}

headers {
  Authorization: Bearer {{token}}
}

assert {
  res.status: eq(201)
  res.body.downloadUrl: $notNull
}

script:post-response {
  const data = res.getBody();
  if (data.downloadUrl) {
    bru.setVar("downloadUrl", data.downloadUrl);
  }
}
